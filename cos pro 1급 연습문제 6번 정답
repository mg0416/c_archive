#include <iostream>
#include <string>
using namespace std;

string solution(const string& a, const string& b) {
    string mergedString;
    int min_length = min(a.length(), b.length());

    for (int i = 0; i < min_length; i++) {
        mergedString += a[i];
        mergedString += b[i];
    }

    mergedString += a.substr(min_length) + b.substr(min_length);

    return mergedString;
}

int main() {
    string a = "abc";
    string b = "def";

    string result = solution(a, b);
    cout << result << endl;

    string a1 = "ab";
    string b1 = "zsd";

    string result1 = solution(a1, b1);
    cout << result1 << endl;

    return 0;
}
